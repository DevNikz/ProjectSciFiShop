#pragma kernel HzbDownMulti

#include "SSGICore_Common.hlsl"

// HZB atlas. Level 1 is written by the NormalsAndHzb1 kernel; this kernel reads it and writes levels 2..5.
// Level 1 is never written here, so reading and writing the same UAV in one dispatch is hazard free.
RWTexture2D<float> _SSGI_HzbOut;

groupshared float gsHzb[16 * 16];

// One 16x16 block of level-1 texels is reduced to 8x8 (level 2), 4x4 (3), 2x2 (4) and 1x1 (5) texels.
// Texels outside a level count as +large so they never win the min (same result as clamping to the edge).
[numthreads(16, 16, 1)]
void HzbDownMulti(uint3 gtid : SV_GroupThreadID, uint3 gid : SV_GroupID)
{
    int2 t = (int2)gtid.xy;
    uint idx = (uint)(t.y * 16 + t.x);
    int2 p1 = (int2)gid.xy * 16 + t;

    float4 r1 = _SSGI_HzbRects[1];
    bool inside = p1.x < (int)r1.z && p1.y < (int)r1.w;
    gsHzb[idx] = inside ? _SSGI_HzbOut[(int2)r1.xy + p1] : 1e30;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (int level = 2; level <= 5; level++)
    {
        int step = 1 << (level - 2);
        int mask = (1 << (level - 1)) - 1;
        if (((t.x | t.y) & mask) == 0)
        {
            uint i0 = idx;
            float m = min(min(gsHzb[i0], gsHzb[i0 + step]),
                          min(gsHzb[i0 + step * 16], gsHzb[i0 + step * 16 + step]));

            int2 q = (int2)gid.xy * (16 >> (level - 1)) + (t >> (level - 1));
            float4 rl = _SSGI_HzbRects[level];
            if (q.x < (int)rl.z && q.y < (int)rl.w)
                _SSGI_HzbOut[(int2)rl.xy + q] = m;

            gsHzb[i0] = m; // active texels are only read by themselves at this level
        }
        GroupMemoryBarrierWithGroupSync();
    }
}
